generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  sessionVersion Int @default(0)
  passwordResetTokens PasswordResetToken[]
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  policyAcceptances PolicyAcceptance[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     WorkspaceMember[]
  weddings    Wedding[]
  subscription Subscription?
  payments     Payment[]
  usageRecords UsageRecord[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, userId])
}

model Wedding {
  id              String   @id @default(cuid())
  workspaceId     String
  legacyPlanCode String?
  legacyPaidThrough DateTime?
  legacyPlanFeatures Json?
  legacyPlanLimits Json?
  name            String
  coupleName1     String
  coupleName2     String?
  date            DateTime?
  venue           String?
  address         String? @db.Text
  mapUrl          String?
  timezone        String   @default("Asia/Kolkata")
  locale          String   @default("en-IN")
  contactVisibility String @default("hidden")
  invitationTheme String   @default("classic")
  publicFields    String[] @default(["venue", "address", "description", "mapUrl", "coverImageUrl", "couplePhotoUrl"])
  description     String? @db.Text
  coverImageUrl   String? @db.Text
  couplePhotoUrl  String? @db.Text
  themeColor      String?
  whatsappMessage String? @db.Text
  rsvpDeadline    DateTime?
  allowGuestEdits Boolean  @default(true)
  invitationToken String   @unique @default(cuid())
  published       Boolean  @default(false)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events          Event[]
  guests          Guest[]
  guestImports    GuestImport[]
  rsvpSubmissions RsvpSubmission[]
  customQuestions CustomQuestion[]
  auditLogs       AuditLog[]
  groupInvitations GroupInvitation[]
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@index([invitationToken])
}

model Event {
  id              String   @id @default(cuid())
  weddingId       String
  name            String
  date            DateTime?
  time            String?
  venue           String?
  address         String? @db.Text
  description     String? @db.Text
  imageUrl        String? @db.Text
  mapUrl          String?
  dressCode       String?
  publicFields    String[] @default(["date", "time", "venue", "address", "description", "mapUrl", "dressCode", "imageUrl"])
  order           Int      @default(0)
  rsvpDeadline    DateTime?
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpEventResponses RsvpEventResponse[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weddingId])
}

model Guest {
  id            String   @id @default(cuid())
  weddingId     String
  firstName     String
  lastName      String?
  mobile        String?
  email         String?
  group         String?
  side          String?
  category      String?
  accommodationNeeds String? @db.Text
  transportNeeds String? @db.Text
  notes         String? @db.Text
  dietaryPrefs  String? @db.Text
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpSubmission RsvpSubmission?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([weddingId, mobile])
  @@index([weddingId])
  @@index([weddingId, group])
  @@index([weddingId, side, category])
}

model RsvpSubmission {
  id              String   @id @default(cuid())
  weddingId       String
  guestId         String   @unique
  groupInvitationId String? @unique
  fullName        String
  mobile          String
  email           String?
  status          String   @default("pending")
  partySize       Int?
  dietaryPrefs    String?  @db.Text
  editTokenHash   String?
  editTokenNonce String?
  browserTokenHash String?
  transferTokenHash String? @unique
  transferGroupBrowserHash String?
  transferExpiresAt DateTime?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  groupInvitation GroupInvitation? @relation(fields: [groupInvitationId], references: [id], onDelete: SetNull)
  familyMembers   FamilyMember[]
  eventResponses  RsvpEventResponse[]
  answers         Answer[]
  createdAt       DateTime @default(now())

  @@index([weddingId])
  @@index([editTokenHash])
}

model FamilyMember {
  id                String         @id @default(cuid())
  rsvpSubmissionId  String
  fullName          String
  relation          String?
  age               Int?
  dietaryPrefs      String? @db.Text
  rsvpSubmission    RsvpSubmission @relation(fields: [rsvpSubmissionId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model RsvpEventResponse {
  id                String         @id @default(cuid())
  rsvpSubmissionId  String
  eventId           String
  status            String         @default("pending")
  rsvpSubmission    RsvpSubmission @relation(fields: [rsvpSubmissionId], references: [id], onDelete: Cascade)
  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([rsvpSubmissionId, eventId])
}

model CustomQuestion {
  id        String   @id @default(cuid())
  weddingId String
  question  String
  type      String   @default("text")
  options   Json?
  required  Boolean  @default(false)
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  answers   Answer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId])
}

model Answer {
  id                String         @id @default(cuid())
  rsvpSubmissionId  String
  questionId        String
  value             String         @db.Text
  rsvpSubmission    RsvpSubmission @relation(fields: [rsvpSubmissionId], references: [id], onDelete: Cascade)
  question          CustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([rsvpSubmissionId, questionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  weddingId String
  action    String
  details   Json?
  userId    String?
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([weddingId])
  @@index([userId])
}

model RateLimit {
  key      String   @id
  count    Int      @default(0)
  resetAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Subscriptions, payments and plan usage
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String?  @db.Text
  // Price is stored in the smallest currency unit (paise) and is nullable:
  // null means "not configured yet" and the UI shows "Coming Soon".
  priceInPaise      Int?
  currency          String   @default("INR")
  billingPeriodDays Int      @default(30)
  features          Json     @default("{}")
  limits            Json     @default("{}")
  isActive          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subscriptions     Subscription[]
  payments          Payment[]
}

model Subscription {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  planId             String
  // ACTIVE | CANCELLED | EXPIRED | PAST_DUE
  status             String   @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  pendingPlanCode    String?
  provider           String   @default("razorpay")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planId], references: [id])
  payments           Payment[]

  @@index([status, currentPeriodEnd])
}

model Payment {
  id                String   @id @default(cuid())
  workspaceId       String
  weddingId         String?
  subscriptionId    String?
  planId            String
  planCode          String
  provider          String   @default("razorpay")
  providerOrderId   String   @unique
  providerPaymentId String?  @unique
  amountInPaise     Int
  baseAmountInPaise Int?
  taxAmountInPaise Int?
  taxRateBasisPoints Int?
  taxInclusive Boolean?
  weddingPlanPriceInPaise Int?
  currency          String   @default("INR")
  // Snapshot of the plan's billing period at purchase time, so later admin
  // changes cannot shorten or extend a payment that was already made.
  billingPeriodDays Int      @default(30)
  // PENDING | PAID | FAILED
  status            String   @default("PENDING")
  receipt           String?
  failureReason     String?  @db.Text
  notes             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  paidAt            DateTime?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wedding           Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan              Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([weddingId, status])
  @@index([status])
}

model UsageRecord {
  id          String   @id @default(cuid())
  workspaceId String
  metric      String
  value       Int
  recordedAt  DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, recordedAt])
}

model GroupInvitation {
  id              String          @id @default(cuid())
  weddingId       String
  label           String
  mobile          String?
  tokenHash       String          @unique
  browserHash     String?
  revokedAt       DateTime?
  checkedInAt     DateTime?
  checkedInBy     String?
  wedding         Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  rsvpSubmission  RsvpSubmission?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([weddingId])
}

model PlatformSettings {
  businessName String @default("")
  legalAddress String @default("")
  supportEmail String @default("")
  grievanceContact String @default("")
  id String @id @default("platform")
  gstEnabled Boolean @default(false)
  gstRateBasisPoints Int @default(1800)
  taxInclusive Boolean @default(false)
  advertisementsEnabled Boolean @default(false)
  dashboardAds Boolean @default(true)
  invitationAds Boolean @default(false)
  publicRsvpAds Boolean @default(false)
  adText String @default("")
  adUrl String @default("")
  updatedAt DateTime @updatedAt
}

model PlatformSettingsAudit {
  id String @id @default(cuid())
  actorUserId String
  changes Json
  createdAt DateTime @default(now())
}

model PolicyAcceptance {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  source         String
  acceptedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
}

model PlatformAdminAudit {
  id          String   @id @default(cuid())
  actorUserId String
  resource    String
  reason      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  sessionVersion Int
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model GuestImport {
  id String @id @default(cuid())
  weddingId String
  keyHash String
  contentHash String
  importedCount Int
  createdAt DateTime @default(now())
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, keyHash])
}

model WeddingDeletionJob {
  reminders WeddingReminder[]
  id                  String   @id @default(cuid())
  weddingId           String?  @unique
  weddingIdHash       String   @unique
  requestedByUserHash  String?
  mode                String   @default("SCHEDULED")
  status              String   @default("PENDING")
  scheduledFor        DateTime
  completedAt         DateTime?
  safeResult          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, scheduledFor])
}

model WeddingReminder {
  id String @id @default(cuid())
  jobId String
  deletionAt DateTime
  offsetDays Int
  scheduledAt DateTime
  status String @default("PENDING")
  attempts Int @default(0)
  leaseUntil DateTime?
  sentAt DateTime?
  providerId String?
  job WeddingDeletionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, deletionAt, offsetDays])
  @@index([status, scheduledAt])
}
