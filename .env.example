# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_guest_manager"

# Auth.js v5 (NextAuth v5)
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_NAME="Wedding Guest Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Payments (Razorpay). When these are missing, paid plans show "Coming Soon"
# and checkout stays disabled; nothing crashes.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="INR"

# Admin console allowlist for plan pricing (comma separated emails).
# Users with User.isAdmin=true are also admins.
ADMIN_EMAILS=""
