# =============================================================================
# Wedding Guest Manager — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit real secrets.
# Required variables must be set in the Vercel project settings dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED for production)
# -----------------------------------------------------------------------------
# Must be a production PostgreSQL connection string (not localhost).
# Supabase: copy the exact pooler host from the project's Connect dialog.
# Transaction pooler (6543) for application traffic; session pooler (5432) for migrations.
# Do not use the IPv6-only db.<PROJECT_REF>.supabase.co host on IPv4-only builds.
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<ENCODED_PASSWORD>@<EXACT_POOLER_HOST>:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<ENCODED_PASSWORD>@<EXACT_POOLER_HOST>:5432/postgres?sslmode=require"
# Percent-encode special characters in passwords (e.g. @ becomes %40).
# For local PostgreSQL both variables can use the same connection.
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_guest_manager"
DIRECT_URL="postgresql://user:password@localhost:5432/wedding_guest_manager"

# -----------------------------------------------------------------------------
# Auth.js v5 / NextAuth v5 (REQUIRED for production)
# -----------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Must be a strong, random string — never use the placeholder in production.
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# App (REQUIRED for production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wedding Guest Manager"
# Must be the production URL (e.g. https://wedding-guest-manager.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Payments — Razorpay (REQUIRED for paid plans; optional otherwise)
# -----------------------------------------------------------------------------
# When these are missing, paid plans show "Coming Soon" and checkout stays
# disabled; nothing crashes. Set real keys in production to accept payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="INR"

# -----------------------------------------------------------------------------
# Admin console (REQUIRED for plan pricing in production)
# -----------------------------------------------------------------------------
# Comma-separated list of admin emails. Users with User.isAdmin=true are also
# admins regardless of this list. Allowlisted emails must be verified.
# Every admin also enrolls an authenticator at /dashboard/admin-access.
# AUTH_SECRET must contain at least 32 characters; changing it requires MFA recovery.
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# Supabase image storage (server-only; optional until uploads are enabled)
# -----------------------------------------------------------------------------
# Use the SAME project as the wedding database. No browser Data API is used.
SUPABASE_STORAGE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ASSET_BUCKET="wedding-assets"
# Create a PRIVATE bucket with a 4 MB limit and image/png,image/jpeg,image/webp.
# Never prefix the service role key with NEXT_PUBLIC_.

# Cloudflare Turnstile, required before requesting guest SMS codes.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional private readiness endpoint, independent from the cron credential.
HEALTH_CHECK_SECRET=""

# Wedding retention runs in dry-run mode unless explicitly enabled.
CRON_SECRET=""
WEDDING_RETENTION_DELETE_ENABLED="false"

# Guest RSVP SMS verification. Use a Twilio Verify service and server-only API credentials.
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""

# Optional verified Google host sign-in. Register /api/auth/callback/google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Server-only Resend transactional email credentials.
RESEND_API_KEY=""
EMAIL_FROM=""

# Send only to verified owner emails after staging email verification.
WEDDING_REMINDER_SEND_ENABLED="false"
