# =============================================================================
# Wedding Guest Manager — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit real secrets.
# Required variables must be set in the Vercel project settings dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED for production)
# -----------------------------------------------------------------------------
# Must be a production PostgreSQL connection string (not localhost).
# Provision via Vercel Postgres, Neon, Supabase, RDS, or similar.
# Example: postgresql://user:pass@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_guest_manager"

# -----------------------------------------------------------------------------
# Auth.js v5 / NextAuth v5 (REQUIRED for production)
# -----------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Must be a strong, random string — never use the placeholder in production.
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# App (REQUIRED for production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wedding Guest Manager"
# Must be the production URL (e.g. https://wedding-guest-manager.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Payments — Razorpay (REQUIRED for paid plans; optional otherwise)
# -----------------------------------------------------------------------------
# When these are missing, paid plans show "Coming Soon" and checkout stays
# disabled; nothing crashes. Set real keys in production to accept payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="INR"

# -----------------------------------------------------------------------------
# Admin console (REQUIRED for plan pricing in production)
# -----------------------------------------------------------------------------
# Comma-separated list of admin emails. Users with User.isAdmin=true are also
# admins regardless of this list.
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# Supabase (NOT USED by current implementation)
# -----------------------------------------------------------------------------
# These variables are present for reference but are not consumed by the app.
# The application uses Prisma + PostgreSQL directly, not Supabase client SDK.
# Remove if not needed.
NEXT_PUBLIC_SUPABASE_URL=https://qdyesqugohaeebcqlqql.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jmQjjE_HZ-555rQKxyCkOA_DiEp-zOF
